Find customers whose total order amount is greater than 500.


SELECT 
    customer_id,
    SUM(amount) AS total_amount
FROM 
    Orders
GROUP BY 
    customer_id
HAVING 
    SUM(amount) > 500;

Find customers who have made more than 1 order

SELECT customer_id 
FROM orders 
GROUP BY customer_id 
HAVING COUNT(*) > 1;


Find items that appear more than once

SELECT  item
FROM orders 
GROUP BY item 
HAVING COUNT(*) > 1;
